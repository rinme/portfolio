{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "#lib": ["./src/lib/index.ts"],
      "#lib/db": ["./src/lib/db/index.ts"],
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "src",
    "src/**/*.svelte"
  ],
  "exclude": [
    "eslint.config.mjs"
  ]
}
